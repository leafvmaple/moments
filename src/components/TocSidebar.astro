---
// Renders an article TOC with nested H3 under each H2.
// Only the currently-active H2's H3 children are expanded; other
// H2 sections collapse — like Handsome theme's TOC behavior.
// Active highlighting + smooth scroll tied to .app-main scroll container.

interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface TocNode {
  slug: string;
  text: string;
  children: TocNode[];
}

interface Props {
  headings: Heading[];
}
const { headings } = Astro.props as Props;
const flat = headings.filter((h) => h.depth >= 2 && h.depth <= 3);

// Group H3s under their preceding H2.
const tree: TocNode[] = [];
let currentH2: TocNode | null = null;
for (const h of flat) {
  const node: TocNode = { slug: h.slug, text: h.text, children: [] };
  if (h.depth === 2) {
    currentH2 = node;
    tree.push(node);
  } else if (currentH2) {
    currentH2.children.push(node);
  } else {
    tree.push(node);
  }
}

const tooFewToBother = flat.length < 3;
---

{
  !tooFewToBother && (
    <nav class="toc" aria-label="文章目录">
      <div class="toc-title">文章目录</div>
      <ul class="toc-list">
        {tree.map((item) => (
          <li class={`toc-item${item.children.length > 0 ? ' has-children' : ''}`}>
            <a href={`#${item.slug}`} data-toc-slug={item.slug}>
              {item.text}
            </a>
            {item.children.length > 0 && (
              <ul class="toc-children">
                {item.children.map((child) => (
                  <li class="toc-item toc-child">
                    <a href={`#${child.slug}`} data-toc-slug={child.slug}>
                      {child.text}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .toc {
    position: sticky;
    /* sticky 顶边紧贴 topbar 底边（topbar 高 56px），不留多余间距，跟 cover/post body 上边对齐 */
    top: var(--topbar-h);
    background: var(--color-bg-card);
    border-radius: var(--radius-card);
    padding: var(--space-md);
    box-shadow: var(--shadow-card);
    max-height: calc(100vh - var(--topbar-h) - var(--space-md));
    overflow-y: auto;
  }

  .toc-title {
    color: var(--color-text-muted);
    font-size: 13px;
    margin-bottom: var(--space-sm);
    padding-left: var(--space-sm);
    letter-spacing: 0.04em;
  }

  .toc-list,
  .toc-children {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-item a {
    display: block;
    padding: 6px var(--space-sm);
    color: var(--color-text-muted);
    font-size: 13px;
    line-height: 1.4;
    border-radius: 4px;
    border-left: 2px solid transparent;
    transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
    text-decoration: none;
  }

  .toc-item a:hover {
    color: var(--color-primary);
    background: rgba(0, 0, 0, 0.025);
  }

  .toc-item a.active {
    color: var(--color-primary);
    background: rgba(0, 0, 0, 0.04);
    border-left-color: var(--color-primary);
  }

  /* 子项默认折叠 —— 只在父 H2 处于 active-parent 状态时展开 */
  .toc-children {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, margin-top 0.3s ease;
  }

  .toc-item.has-children.active-parent > .toc-children {
    max-height: 1000px;
    margin-top: 4px;
  }

  .toc-child a {
    padding-left: calc(var(--space-sm) + var(--space-md));
    font-size: 12px;
  }

  /* TOC 自己的滚动条克制一些 */
  .toc {
    scrollbar-width: thin;
    scrollbar-color: var(--scrollbar-thumb) transparent;
  }
  .toc::-webkit-scrollbar {
    width: 4px;
  }
  .toc::-webkit-scrollbar-thumb {
    background: var(--scrollbar-thumb);
    border-radius: 2px;
  }
</style>

<script is:inline>
  // Scroll-spy: 跟踪当前阅读到的 heading；同时把它所属的 H2 li 设为 active-parent
  // 让 .toc-children 展开（其余 H2 的子项收起）。
  // 滚动容器是 .app-main（height: 100vh + overflow-y: auto）而不是 window。

  function initToc() {
    const tocLinks = document.querySelectorAll('.toc a[data-toc-slug]');
    if (tocLinks.length === 0) return;

    const scrollHost = document.querySelector('.app-main');
    const usesAppMain = !!scrollHost && getComputedStyle(scrollHost).overflowY === 'auto';
    const scroller = usesAppMain ? scrollHost : window;

    const slugToLink = new Map();
    const headings = [];
    tocLinks.forEach((link) => {
      const slug = link.dataset.tocSlug;
      if (!slug) return;
      const el = document.getElementById(slug);
      if (el) {
        slugToLink.set(slug, link);
        headings.push(el);
      }
    });
    if (headings.length === 0) return;

    let currentActiveLink = null;
    let currentActiveParent = null;

    function setActive(slug) {
      const link = slug ? slugToLink.get(slug) || null : null;

      // 1) 高亮当前 link
      if (link !== currentActiveLink) {
        if (currentActiveLink) currentActiveLink.classList.remove('active');
        if (link) link.classList.add('active');
        currentActiveLink = link;
      }

      // 2) 决定哪个 H2 li 该展开
      // closest('.has-children') 找到当前 link 所在的（或所属的）H2 li。
      // - link 在 H2 li 上：closest 直接返回该 H2 li
      // - link 在 H3 li (.toc-child) 上：closest 沿祖先链找到包裹它的 .has-children H2 li
      let parentH2Li = null;
      if (link) {
        const candidate = link.closest('.toc-item.has-children');
        if (candidate) parentH2Li = candidate;
      }

      if (parentH2Li !== currentActiveParent) {
        if (currentActiveParent) currentActiveParent.classList.remove('active-parent');
        if (parentH2Li) parentH2Li.classList.add('active-parent');
        currentActiveParent = parentH2Li;
      }
    }

    const TRIGGER_OFFSET = 100;
    const SCROLL_IDLE_MS = 150;

    // 用户点击 TOC 链接时锁定 scroll-spy。不依赖 scrollend 事件（在 smooth scroll
    // 的最终结算阶段触发时机不稳定，会让 scroll-spy 在末尾几帧短暂解锁、算出
    // 一个跳变的 active）。改成"scroll idle"模式：scroll 事件持续 SCROLL_IDLE_MS
    // 都没有再触发，才认为滚动真正停下。
    let isUserScrolling = false;
    let idleTimer = null;
    function bumpIdleTimer() {
      if (!isUserScrolling) return;
      if (idleTimer) clearTimeout(idleTimer);
      idleTimer = setTimeout(() => {
        isUserScrolling = false;
        idleTimer = null;
      }, SCROLL_IDLE_MS);
    }

    function updateActive() {
      const containerTop = usesAppMain ? scrollHost.getBoundingClientRect().top : 0;
      let activeSlug = null;
      for (const h of headings) {
        const offset = h.getBoundingClientRect().top - containerTop;
        if (offset - TRIGGER_OFFSET <= 0) {
          activeSlug = h.id;
        } else {
          break;
        }
      }
      setActive(activeSlug);
    }

    function onScroll() {
      if (isUserScrolling) {
        // 锁定期间：每个 scroll 事件重置 idle timer。scroll 停下来 150ms 才解锁。
        bumpIdleTimer();
        return;
      }
      updateActive();
    }

    updateActive();
    scroller.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', updateActive);

    /*
     * 自实现的滚动动画 —— 目前用「匀速」(linear)。
     *
     * 之所以不用原生 element.scrollIntoView({behavior:'smooth'})：
     *   原生 smooth 是浏览器默认的 ease-out 缓动曲线（开头快、结尾慢），
     *   用户希望整段动画是匀速的、所以自己 rAF 驱动 scrollTop。
     *
     * 想恢复成原生 ease-out (快→慢)，**最简一行替换**：
     *   把 `animatedScrollTo(target)` 改回
     *   `target.scrollIntoView({behavior:'smooth', block:'start'})`
     *
     * 想换其它 easing curve，把 step() 里
     *   `const eased = progress;          // linear`
     * 改成下面任一行：
     *   const eased = 1 - (1 - progress) * (1 - progress);          // ease-out (快→慢)
     *   const eased = progress * progress;                          // ease-in  (慢→快)
     *   const eased = progress < 0.5                                // ease-in-out
     *     ? 2 * progress * progress
     *     : 1 - 2 * (1 - progress) * (1 - progress);
     *   const eased = 1 - Math.pow(1 - progress, 3);                // cubic ease-out
     */
    function animatedScrollTo(targetEl, duration = 400) {
      const containerTop = usesAppMain ? scrollHost.getBoundingClientRect().top : 0;
      const currentScrollTop = usesAppMain ? scrollHost.scrollTop : window.scrollY;
      // 读 CSS 的 scroll-margin-top（全局 .markdown-body h1/h2/h3 上设了 56+16=72px）
      const scrollMargin = parseFloat(getComputedStyle(targetEl).scrollMarginTop) || 0;
      const targetScrollTop =
        currentScrollTop + (targetEl.getBoundingClientRect().top - containerTop) - scrollMargin;
      const startScrollTop = currentScrollTop;
      const delta = targetScrollTop - startScrollTop;
      if (Math.abs(delta) < 1) return;
      const startTime = performance.now();
      function step(now) {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const eased = progress; // linear —— 匀速
        const newTop = startScrollTop + delta * eased;
        if (usesAppMain) {
          scrollHost.scrollTop = newTop;
        } else {
          window.scrollTo(0, newTop);
        }
        if (progress < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }

    tocLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        const slug = link.dataset.tocSlug;
        if (!slug) return;
        const target = document.getElementById(slug);
        if (!target) return;
        e.preventDefault();
        // 上锁、起 idle timer、再开滚、再立即 setActive。
        // 自实现的滚动每帧都会改 scrollTop、原生 scroll 事件持续触发，
        // 会一直 bump idle timer 保持上锁；停 150ms 才解锁。
        isUserScrolling = true;
        bumpIdleTimer();
        animatedScrollTo(target);
        history.replaceState(null, '', `#${slug}`);
        setActive(slug);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initToc);
  } else {
    initToc();
  }
</script>
