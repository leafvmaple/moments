---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const places = await getCollection('places');
  return places.map((place) => ({
    params: { slug: place.id },
    props: { place },
  }));
}

type Place = Awaited<ReturnType<typeof getCollection<'places'>>>[number];

const { place } = Astro.props as { place: Place };
const { Content } = await render(place);

const allPlaces = await getCollection('places');
const allPosts = await getCollection('posts');

// Child places (direct descendants only for now)
const children = allPlaces.filter((p) => p.data.parent === place.id);

// All descendant place ids (subtree, including self)
const descendantIds = new Set<string>([place.id]);
{
  const queue: string[] = [place.id];
  while (queue.length > 0) {
    const cur = queue.shift()!;
    for (const p of allPlaces) {
      if (p.data.parent === cur && !descendantIds.has(p.id)) {
        descendantIds.add(p.id);
        queue.push(p.id);
      }
    }
  }
}

// Posts in the subtree (self or any descendant), sorted by date desc
const subtreePosts = allPosts
  .filter((p) => p.data.places.some((id) => descendantIds.has(id)))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Breadcrumb of ancestors (for nesting context)
const placeById = new Map(allPlaces.map((p) => [p.id, p]));
const ancestors: Place[] = [];
let cursor = place.data.parent;
while (cursor) {
  const parent = placeById.get(cursor);
  if (!parent) break;
  ancestors.unshift(parent);
  cursor = parent.data.parent;
}

const fmtPostDate = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout
  title={place.data.name}
  description={place.data.excerpt}
  pageTitle={place.data.name}
  ogImage={place.data.cover}
  ogType="article"
>
  <div class="content-grid">
    <div class="content-main">
      <article class="place">
        {place.data.cover && <img src={place.data.cover} alt={place.data.name} class="place-cover" />}
        <div class="place-body">
          {
            ancestors.length > 0 && (
              <nav class="place-breadcrumb">
                <a href="/places">地点</a>
                {ancestors.map((a) => (
                  <>
                    <Icon name="chevronRight" size={12} />
                    <a href={`/places/${a.id}`}>{a.data.name}</a>
                  </>
                ))}
              </nav>
            )
          }
          <h1 class="place-title">{place.data.name}</h1>
          {place.data.excerpt && <p class="place-excerpt">{place.data.excerpt}</p>}
          <div class="markdown-body">
            <Content />
          </div>

          {
            children.length > 0 && (
              <section class="place-children">
                <h2 class="place-section-title">子地点</h2>
                <ul class="child-list">
                  {children.map((c) => (
                    <li>
                      <a href={`/places/${c.id}`}>{c.data.name}</a>
                      {c.data.excerpt && <span class="child-excerpt"> —— {c.data.excerpt}</span>}
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          {
            subtreePosts.length > 0 && (
              <section class="place-posts">
                <h2 class="place-section-title">在这里的日记</h2>
                <ol class="post-list">
                  {subtreePosts.map((p) => (
                    <li>
                      <a class="post-link" href={`/posts/${p.id}`}>
                        {p.data.cover ? (
                          <img class="post-thumb" src={p.data.cover} alt={p.data.title} loading="lazy" />
                        ) : (
                          <div class="post-thumb post-thumb-placeholder">
                            <Icon name="fileText" size={20} />
                          </div>
                        )}
                        <div class="post-text">
                          <span class="post-date">{fmtPostDate(p.data.date)}</span>
                          <span class="post-title">{p.data.title}</span>
                          {p.data.excerpt && <span class="post-excerpt">{p.data.excerpt}</span>}
                        </div>
                      </a>
                    </li>
                  ))}
                </ol>
              </section>
            )
          }
        </div>
      </article>
    </div>
    <Sidebar />
  </div>
</BaseLayout>

<style>
  .place {
    background: var(--color-bg-card);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  .place-cover {
    width: 100%;
    aspect-ratio: 16 / 6;
    object-fit: cover;
  }
  .place-body {
    padding: var(--space-xl);
  }
  .place-breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--color-text-muted);
    font-size: 12px;
    margin-bottom: var(--space-sm);
  }
  .place-breadcrumb a {
    color: var(--color-text-muted);
    transition: color 0.15s ease;
  }
  .place-breadcrumb a:hover {
    color: var(--color-primary);
  }
  .place-title {
    font-size: 26px;
    margin: 0 0 var(--space-md);
    font-weight: 300;
  }
  .place-excerpt {
    color: var(--color-text);
    font-size: 15px;
    line-height: 1.7;
    margin: 0 0 var(--space-lg);
  }
  .place-section-title {
    font-size: 16px;
    font-weight: 600;
    margin: var(--space-lg) 0 var(--space-md);
    color: var(--color-heading);
  }

  .child-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .child-list li {
    padding: var(--space-xs) 0;
  }
  .child-list a {
    color: var(--color-heading);
    font-weight: 500;
    transition: color 0.15s ease;
  }
  .child-list a:hover {
    color: var(--color-primary);
  }
  .child-excerpt {
    color: var(--color-text-muted);
    font-size: 13px;
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .post-link {
    display: flex;
    gap: var(--space-md);
    padding: var(--space-md);
    background: var(--color-bg-subtle);
    border-radius: var(--radius-card);
    transition: background 0.15s ease;
  }
  .post-link:hover {
    background: var(--color-bg-card);
    box-shadow: var(--shadow-card);
  }
  .post-thumb {
    width: 80px;
    height: 80px;
    border-radius: 6px;
    object-fit: cover;
    flex-shrink: 0;
  }
  .post-thumb-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-card);
    color: var(--color-text-muted);
  }
  .post-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .post-date {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .post-title {
    color: var(--color-heading);
    font-size: 15px;
    font-weight: 600;
  }
  .post-link:hover .post-title {
    color: var(--color-primary);
  }
  .post-excerpt {
    color: var(--color-text-muted);
    font-size: 12px;
    line-height: 1.55;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
</style>
